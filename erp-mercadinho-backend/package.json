{
  "name": "erp-mercadinho-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs",
    "test:sql": "node scripts/verify-sql.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
